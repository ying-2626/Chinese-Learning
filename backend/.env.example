# Export these variables in the backend process environment before starting Maven/Java.
# Spring Boot does not automatically read a .env file.
SERVER_PORT=8088
DB_URL='jdbc:mysql://127.0.0.1:3306/chinese_learning?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai'
DB_USERNAME=root
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
# Use a local SMTP inbox for development; real providers may require AUTH and STARTTLS.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
TENCENT_SOE_APPID=
TENCENT_SOE_SECRET_ID=
TENCENT_SOE_SECRET_KEY=
FASTGPT_API_KEY=
FASTGPT_API_URL=https://api.fastgpt.in/api/v1/chat/completions
AUDIO_STORAGE_DIR=./data/audios
AUDIO_PUBLIC_BASE_URL=/audios
