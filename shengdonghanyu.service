[Unit]
Description=ShengDongHanYu Backend Service
After=network.target mysqld.service redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu
# 小内存服务器（2 核 / 2 GB）：堆上限 512 MB，串行 GC 占用更少
Environment="JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseSerialGC -XX:MaxMetaspaceSize=256m"
# 数据库、Redis、邮件与各项密钥（仅 root 可读；格式见仓库 backend/.env.example）
EnvironmentFile=/home/ubuntu/shengdonghanyu.env
ExecStart=/usr/bin/java $JAVA_OPTS -jar /home/ubuntu/backend-0.0.1-SNAPSHOT.jar
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
